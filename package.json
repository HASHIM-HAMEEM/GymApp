    "expo-background-task": "^57.0.16",
    "expo-camera": "57.0.4",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
