  "devDependencies": {
    "@types/react": "~19.2.2",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "verify:client": "node scripts/verify-client.mjs",
    "verify:sql": "bash scripts/verify-sql.sh",
    "verify:edge": "cd supabase/functions && npx tsc --noEmit --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --strict --allowImportingTsExtensions --ignoreConfig runtime.d.ts create-member-invitation/index.ts resend-member-invitation/index.ts send-notice-push/index.ts process-push-receipts/index.ts send-expiry-reminders/index.ts",
    "verify": "npm run typecheck && npm run verify:client && npm run verify:sql && npm run verify:edge && npm run build:web",
    "bootstrap:admin": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs"
  },
  "private": true
}
